      "css": ".ds-filters{display:inline-flex;flex-wrap:wrap;gap:9px;font-family:var(--font-sans,Manrope),sans-serif}.ds-filter{cursor:pointer;padding:11px 21px;border:1px solid #BBC8A3;border-radius:50px;background:transparent;color:var(--foreground,#173B2B);font-family:var(--font-sans,Manrope),sans-serif;font-size:14px;transition:background .25s,color .25s}.ds-filter:hover{background:var(--muted,#F0F3E6)}.ds-filter[aria-pressed=true]{background:var(--primary,#173B2B);border-color:var(--primary,#173B2B);color:var(--background,#FAFFFF)}.ds-filter:focus-visible{outline:2px solid var(--ring,#8A6317);outline-offset:5px}@media(max-width:600px){.ds-filters{gap:7px}.ds-filter{padding:10px 14px;font-size:12px}}@media(prefers-reduced-motion:reduce){.ds-filter{transition-duration:.01ms}}"
