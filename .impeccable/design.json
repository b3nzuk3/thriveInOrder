      "kind": "button",
      "refersTo": "button-outline",
      "description": "A supporting action, including copying the prepared enquiry.",
      "html": "<button class=\"ds-button ds-outline\">Copy enquiry</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:12px;height:52px;padding:0 28px;border:0;border-radius:9999px;white-space:nowrap;font-family:var(--font-sans,Manrope),sans-serif;font-size:14px;font-weight:600;cursor:pointer;transition:background-color .15s,color .15s}.ds-button:focus-visible{outline:2px solid var(--ring,#8A6317);outline-offset:4px}.ds-button:disabled{pointer-events:none;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-button{transition-duration:.01ms}}.ds-outline{border:1px solid var(--primary,#173B2B);background:transparent;color:var(--primary,#173B2B)}.ds-outline:hover{background:var(--secondary,#DDE4B8)}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "The gentle olive action used on the forest closing field.",
      "html": "<button class=\"ds-button ds-secondary\">Book a consultation <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:12px;height:52px;padding:0 28px;border:0;border-radius:9999px;white-space:nowrap;font-family:var(--font-sans,Manrope),sans-serif;font-size:14px;font-weight:600;cursor:pointer;transition:background-color .15s,color .15s}.ds-button:focus-visible{outline:2px solid var(--ring,#8A6317);outline-offset:4px}.ds-button:disabled{pointer-events:none;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-button{transition-duration:.01ms}}.ds-secondary{background:var(--secondary,#DDE4B8);color:var(--secondary-foreground,#173B2B)}.ds-secondary:hover{background:#CCD79A}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "An available library variant for a quiet tertiary action.",
      "html": "<button class=\"ds-button ds-ghost\">Quiet action</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:12px;height:52px;padding:0 28px;border:0;border-radius:9999px;white-space:nowrap;font-family:var(--font-sans,Manrope),sans-serif;font-size:14px;font-weight:600;cursor:pointer;transition:background-color .15s,color .15s}.ds-button:focus-visible{outline:2px solid var(--ring,#8A6317);outline-offset:4px}.ds-button:disabled{pointer-events:none;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-button{transition-duration:.01ms}}.ds-ghost{background:transparent;color:var(--primary,#173B2B)}.ds-ghost:hover{background:var(--muted,#F0F3E6)}"
    },
    {
      "name": "Enquiry Fields",
      "kind": "input",
      "refersTo": "form-field",
      "description": "Input and textarea with labels, visible focus, and an invalid-state example.",
      "html": "<div class=\"ds-fields\"><label class=\"ds-label\" for=\"ds-name\">Your name <span>*</span></label><input class=\"ds-field\" id=\"ds-name\" autocomplete=\"name\" placeholder=\"Your name\"><label class=\"ds-label ds-spaced\" for=\"ds-message\">A little about your space <span>*</span></label><textarea class=\"ds-field ds-textarea\" id=\"ds-message\" placeholder=\"What would you love to feel easier at home?\" aria-invalid=\"true\" aria-describedby=\"ds-error\"></textarea><p class=\"ds-error\" id=\"ds-error\">Tell us a little more about your space.</p></div>",
      "css": ".ds-fields{max-width:440px;font-family:var(--font-sans,Manrope),sans-serif}.ds-label{display:block;margin-bottom:10px;color:var(--primary,#173B2B);font-size:13px;font-weight:600}.ds-label span{color:var(--muted-foreground,#4B5D4D)}.ds-spaced{margin-top:22px}.ds-field{width:100%;padding:14px 15px;border:1px solid var(--input,#BDC9A7);border-radius:8px;background:var(--background,#FAFFFF);color:var(--ink,#252A25);font-family:var(--font-sans,Manrope),sans-serif;font-size:15px;line-height:1.6;box-shadow:none;transition:border-color .2s}.ds-field:hover{border-color:#7C906A}.ds-field:focus-visible{border-color:var(--primary,#173B2B);outline:2px solid var(--primary,#173B2B);outline-offset:2px}.ds-field::placeholder{color:#60705D;opacity:1}.ds-field[aria-invalid=true]{border-color:#8C3C28}.ds-textarea{min-height:144px;resize:vertical}.ds-error{margin:8px 0 0;font-size:12px;line-height:1.6;color:#8C3C28}@media(max-width:600px){.ds-field{font-size:16px}}@media(prefers-reduced-motion:reduce){.ds-field{transition-duration:.01ms}}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "description": "Open desktop links with a gold hover/current underline and a pill CTA.",
      "html": "<nav class=\"ds-navigation\" aria-label=\"Example navigation\"><a class=\"ds-nav-link\" href=\"#services\" aria-current=\"page\">Services</a><a class=\"ds-nav-link\" href=\"#approach\">Our approach</a><a class=\"ds-nav-link\" href=\"#faqs\">FAQs</a><a class=\"ds-button ds-nav-action\" href=\"#contact\">Book a consultation</a></nav>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:12px;height:52px;padding:0 28px;border:0;border-radius:9999px;white-space:nowrap;font-family:var(--font-sans,Manrope),sans-serif;font-size:14px;font-weight:600;cursor:pointer;transition:background-color .15s,color .15s}.ds-button:focus-visible{outline:2px solid var(--ring,#8A6317);outline-offset:4px}.ds-button:disabled{pointer-events:none;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-button{transition-duration:.01ms}}.ds-navigation{display:flex;flex-wrap:wrap;align-items:center;gap:32px;color:var(--foreground,#173B2B);font-family:var(--font-sans,Manrope),sans-serif;font-size:18px}.ds-nav-link{position:relative;display:inline-block;padding:10px 0;color:inherit;text-decoration:none}.ds-nav-link::after{content:\"\";position:absolute;left:0;bottom:4px;width:100%;height:1px;background:var(--gold,#C58B17);transform:scaleX(0);transform-origin:left;transition:transform .25s ease}.ds-nav-link:hover::after,.ds-nav-link[aria-current=page]::after{transform:scaleX(1)}.ds-nav-link:focus-visible{outline:2px solid var(--ring,#8A6317);outline-offset:5px}.ds-nav-action{height:56px;width:238px;padding:0;font-size:18px;font-weight:500;background:var(--primary,#173B2B);color:var(--primary-foreground,#FAFFFF);text-decoration:none}.ds-nav-action:hover{background:#28553E}@media(prefers-reduced-motion:reduce){.ds-nav-link::after{transition-duration:.01ms}}"
