    {
      "name": "Practical Panel",
      "kind": "card",
      "refersTo": "practical-panel",
      "description": "Flat grouping for concrete service support, with inline SVG checks.",
      "html": "<section class=\"ds-practical\"><h3>Support can include</h3><ul><li><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m20 6-11 11-5-5\"/></svg><span>Storage that makes everyday essentials easy to find.</span></li><li><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m20 6-11 11-5-5\"/></svg><span>Simple routines that fit the household.</span></li></ul></section>",
      "css": ".ds-practical{max-width:540px;background:var(--muted,#F0F3E6);padding:26px;border-radius:16px;color:var(--foreground,#173B2B);font-family:var(--font-sans,Manrope),sans-serif}.ds-practical h3{margin:0 0 16px;font-family:var(--font-sans,Manrope),sans-serif;font-size:15px;font-weight:600}.ds-practical ul{display:flex;flex-direction:column;gap:13px;list-style:none;padding:0;margin:0}.ds-practical li{display:flex;align-items:flex-start;gap:11px;font-size:14px;line-height:1.65;color:var(--muted-foreground,#4B5D4D)}.ds-practical svg{flex-shrink:0;margin-top:3px;color:var(--primary,#173B2B)}@media(max-width:600px){.ds-practical{padding:22px}}"
    },
    {
      "name": "Expandable Service Summary",
      "kind": "custom",
      "refersTo": "accordion-row",
      "description": "The divider-list visual, using native details for a framework-free expandable preview.",
      "html": "<details class=\"ds-accordion\"><summary>Home organization <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></summary><div class=\"ds-answer\"><p>Practical systems that work with your home and everyday routines.</p><a class=\"ds-enquire\" href=\"#contact\">Ask about this service <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></a></div></details>",
      "css": ".ds-accordion{width:100%;max-width:640px;border-bottom:1px solid var(--border,#D3DDBB);color:var(--foreground,#173B2B);font-family:var(--font-sans,Manrope),sans-serif}.ds-accordion summary{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:22px 0;list-style:none;cursor:pointer;font-size:clamp(17px,1.47vw,22px);font-weight:500;line-height:1.4;letter-spacing:-.025em;transition:color .15s}.ds-accordion summary::-webkit-details-marker{display:none}.ds-accordion summary:hover{color:#477153}.ds-accordion summary:focus-visible,.ds-enquire:focus-visible{outline:2px solid var(--ring,#8A6317);outline-offset:5px}.ds-accordion summary svg{width:20px;height:20px;flex-shrink:0;color:#A67211;transition:transform .3s}.ds-accordion[open] summary svg{transform:rotate(90deg)}.ds-answer{padding-bottom:24px}.ds-answer p{max-width:60ch;margin:0;color:var(--muted-foreground,#4B5D4D);font-size:16px;line-height:1.8}.ds-enquire{display:inline-flex;gap:13px;align-items:center;margin-top:14px;color:inherit;font-size:15px;line-height:1.5;text-decoration:none}.ds-enquire svg{transition:transform .25s ease}.ds-enquire:hover{text-decoration:underline;text-decoration-color:var(--gold,#C58B17)}.ds-enquire:hover svg{transform:translateX(4px)}@media(max-width:480px){.ds-accordion summary{font-size:16px;padding:20px 0;gap:18px}}@media(prefers-reduced-motion:reduce){.ds-accordion summary,.ds-accordion summary svg,.ds-enquire svg{transition-duration:.01ms}}"
    }
  ],
  "narrative": {
    "northStar": "The Home Care Folio",
    "overview": "The Home Care Folio makes practical home support feel soft, personal, and approachable. Forest ink, gentle olive fields, rounded photographs, and friendly everyday language give the interface the ease of a thoughtfully arranged home. The durable brand commitment is “Organized Spaces, Brighter Days.”\n\nThe system is spacious and mostly flat. Editorial serif headings establish warmth, Manrope keeps service choices and forms direct, and natural household imagery provides material richness. Open sections carry the story; softly filled cards group practical information. Motion reveals content or explains a change, with a quiet static alternative for reduced motion.",
    "keyCharacteristics": [
      "Soft, personal color and rounded details.",
      "Warm household photography paired with clear, open service choices.",
      "Editorial serif hierarchy with readable sans-serif copy and controls.",
      "Flat tonal surfaces, restrained gold cues, and purposeful motion."
    ],
    "rules": [
      {
        "name": "The Five-Color Anchor Rule",
        "body": "Keep the five confirmed brand colors as the visual anchor. Derived greens, golds, and the error color serve text, borders, focus, or interaction states rather than forming a competing palette.",
        "section": "colors"
      },
      {
        "name": "The Three-Role Type Rule",
        "body": "Use DM Serif Display for the home hero, Cantata One for the wordmark and supporting display headings, and Manrope for reading and interaction. Preserve the hero’s native weight and natural proportions.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Use color, spacing, and fine dividers to separate content. Cards and fields carry no shadow; the open mobile menu alone has a diffuse separating shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the confirmed palette and assign forest to primary actions, olive to gentle emphasis, and air to the main ground.",
      "Do keep service text and forms in Manrope and use the three established serif roles deliberately.",
      "Do use rounded photographs and local imagery that feels warm, practical, and lived in.",
      "Do keep service summaries expandable, service detail sections open, and practical information grouped in flat filled panels.",
      "Do preserve visible keyboard focus, associated field errors, comfortable mobile controls, and reduced-motion alternatives.",
      "Do keep the existing generated-image provenance and self-hosted font license files with their assets."
    ],
    "donts": [
      "Don’t introduce ornamental UI clutter or hard card shadows into this soft, personal system.",
      "Don’t stretch or compress the hero letterforms to fit a reference.",
      "Don’t use the bright gold brand accent as small body text; the implementation uses darker gold for arrows and focus.",
      "Don’t present the generated household images as completed client work.",
      "Don’t turn the homepage composition into a required layout for every page."
    ]
  }
}
