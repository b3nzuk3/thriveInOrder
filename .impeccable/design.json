    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The main consultation and enquiry action.",
      "html": "<button class=\"ds-button ds-primary\">Book a consultation <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:12px;height:52px;padding:0 28px;border:0;border-radius:9999px;white-space:nowrap;font-family:var(--font-sans,Manrope),sans-serif;font-size:14px;font-weight:600;cursor:pointer;transition:background-color .15s,color .15s}.ds-button:focus-visible{outline:2px solid var(--ring,#8A6317);outline-offset:4px}.ds-button:disabled{pointer-events:none;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-button{transition-duration:.01ms}}.ds-primary{background:var(--primary,#173B2B);color:var(--primary-foreground,#FAFFFF)}.ds-primary:hover{background:#28553E}"
    },
    {
